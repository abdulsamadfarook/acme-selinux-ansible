#!/usr/bin/python3
"""acme-api: stand-in for a 'legacy' core-banking service.

Deliberately awkward for SELinux:
  * listens on a non-standard TCP port
  * writes logs to a custom directory
  * creates a unix admin socket whose NAME changes every start (admin-<pid>.sock)
  * talks to PostgreSQL on a non-standard port on another host
"""
import json
import logging
import os
import socket
import socketserver
import threading
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

import psycopg2

CONF = json.load(open(os.environ.get("ACME_API_CONFIG", "/etc/acme/api.json")))
logging.basicConfig(
    filename=os.path.join(CONF["log_dir"], "api.log"),
    level=logging.INFO,
    format="%(asctime)s %(levelname)s %(message)s",
)
log = logging.getLogger("acme-api")


def db():
    return psycopg2.connect(
        host=CONF["db_host"], port=CONF["db_port"], dbname=CONF["db_name"],
        user=CONF["db_user"], password=CONF["db_password"], connect_timeout=3,
    )


class Handler(BaseHTTPRequestHandler):
    def _send(self, code, body):
        data = json.dumps(body, default=str).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        try:
            if self.path == "/health":
                with db() as conn, conn.cursor() as cur:
                    cur.execute("select 1")
                self._send(200, {"status": "ok", "db": "ok", "host": socket.gethostname()})
            elif self.path == "/accounts":
                with db() as conn, conn.cursor() as cur:
                    cur.execute("select id, owner, balance from accounts order by id")
                    rows = [dict(zip(("id", "owner", "balance"), r)) for r in cur.fetchall()]
                self._send(200, rows)
            else:
                self._send(404, {"error": "not found"})
        except Exception as exc:  # surface failures (e.g. an SELinux denial) as 503
            log.error("request %s failed: %s", self.path, exc)
            self._send(503, {"status": "error", "detail": str(exc)})

    def log_message(self, fmt, *args):
        log.info("%s %s", self.address_string(), fmt % args)


class Server(ThreadingHTTPServer):
    # HTTPServer.server_bind() calls socket.getfqdn(), a reverse DNS lookup that
    # took 20 s to time out in the lab - 20 s of "connection refused" on every
    # restart. Not an SELinux problem (reproduced outside the domain); skip it.
    def server_bind(self):
        socketserver.TCPServer.server_bind(self)
        self.server_name, self.server_port = self.server_address[:2]


def admin_socket():
    path = os.path.join(CONF["run_dir"], "admin-%d.sock" % os.getpid())
    srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    srv.bind(path)
    os.chmod(path, 0o660)
    srv.listen(5)
    log.info("admin socket listening on %s", path)
    while True:
        conn, _ = srv.accept()
        conn.sendall(b'{"status": "ok"}\n')
        conn.close()


if __name__ == "__main__":
    threading.Thread(target=admin_socket, daemon=True).start()
    log.info("acme-api starting on %s:%s", CONF["listen"], CONF["port"])
    Server((CONF["listen"], CONF["port"]), Handler).serve_forever()
